$scope module seq_tb $end
$var reg 1 ! clk $end
$var reg 1 " reset $end
$var reg 1 # din $end
$var wire 1 $ det_moore $end
$var wire 1 % det_mealy $end
$var reg 4 & hist [3:0] $end
$var integer 32 ' errors $end
$var integer 32 ( checks $end
$var integer 32 ) moore_cnt $end
$var integer 32 * mealy_cnt $end

$scope task send_bit $end
$var reg 1 + b $end
$upscope $end

$scope task do_reset $end
$upscope $end

$scope task run_stream $end
$var reg 32 , bits [31:0] $end
$var integer 32 - n $end
$var reg 128 . name [127:0] $end
$var integer 32 / k $end
$upscope $end

$scope module u_moore $end
$var parameter 3 0 S0 $end
$var parameter 3 1 S1 $end
$var parameter 3 2 S10 $end
$var parameter 3 3 S101 $end
$var parameter 3 4 S1011 $end
$var wire 1 5 clk $end
$var wire 1 6 reset $end
$var wire 1 7 din $end
$var wire 1 $ detected $end
$var reg 3 8 state [2:0] $end
$var reg 3 9 next [2:0] $end
$upscope $end

$scope module u_mealy $end
$var parameter 2 : S0 $end
$var parameter 2 ; S1 $end
$var parameter 2 < S10 $end
$var parameter 2 = S101 $end
$var wire 1 > clk $end
$var wire 1 ? reset $end
$var wire 1 @ din $end
$var wire 1 % detected $end
$var reg 2 A state [1:0] $end
$var reg 2 B next [1:0] $end
$upscope $end
$upscope $end
$enddefinitions $end
